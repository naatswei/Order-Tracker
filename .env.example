# ==============================================================================
# Order-Tracker Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (Required)
# https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/backoffice
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/business-type

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Vercel Postgres / Neon)
# Auto-populated if using Vercel Postgres Storage integration.
# ------------------------------------------------------------------------------
POSTGRES_URL=postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Application URL (Required for callback URLs, web push, and SMS tracking links)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.otracker.net

# ------------------------------------------------------------------------------
# 4. Paystack (Payments, Subaccounts & Merchant Settlements)
# https://dashboard.paystack.com/#/settings/developer
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# ------------------------------------------------------------------------------
# 5. BulkClix (SMS Notifications & MoMo/Bank Instant Payouts)
# ------------------------------------------------------------------------------
BULKCLIX_API_KEY=s7JHkdFAXNAHKuuzQ00MQyhcpd5aZoB8hyirebM
BULKCLIX_SENDER_ID=OTracker

# ------------------------------------------------------------------------------
# 6. Hubtel (Alternative SMS Gateway)
# ------------------------------------------------------------------------------
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=OTracker

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (VAPID Keys)
# Generate with `npx web-push generate-vapid-keys`
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 8. Email (Resend) & Automation Cron
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
CRON_SECRET=

# ------------------------------------------------------------------------------
# 9. Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=hubtel_order_tracker_secret_super_key_2026
